cabal-version: 3.0
name:          funknown-tools
version:       0.1.0.0
synopsis:      Generators and checks for funknown-core: registries in, Haskell out
build-type:    Simple

common tools
  build-depends:    base, containers
  default-language: Haskell2010
  ghc-options:      -Wall -Werror=incomplete-patterns

library
  import:           tools
  hs-source-dirs:   src
  exposed-modules:  Funknown.Tools.Csv
                    Funknown.Tools.Json
                    Funknown.Tools.Xml
                    Funknown.Tools.Sha256
                    Funknown.Tools.Statements
                    Funknown.Tools.Emit
                    Funknown.Tools.Gen.Status
                    Funknown.Tools.Gen.Rpc
                    Funknown.Tools.Gen.Digest
                    Funknown.Tools.Gen.Problem
  build-depends:    bytestring

executable gen-vocab
  import:           tools
  hs-source-dirs:   app
  main-is:          GenVocab.hs
  build-depends:    funknown-tools, bytestring, text, directory, filepath
