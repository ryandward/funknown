{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "stagings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string"
              },
              "tokens": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "ref",
              "tokens"
            ],
            "additionalProperties": false
          }
        },
        "object": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string"
                },
                "vouching": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "t": {
                          "type": "string",
                          "const": "Vouched"
                        },
                        "checksum": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$"
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "t",
                        "checksum",
                        "size"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "t": {
                          "type": "string",
                          "const": "Unvouchable"
                        }
                      },
                      "required": [
                        "t"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "t": {
                          "type": "string",
                          "const": "NotYetVouched"
                        }
                      },
                      "required": [
                        "t"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "version",
                "vouching"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "stagings",
        "object"
      ],
      "additionalProperties": false
    },
    {
      "type": "null"
    }
  ],
  "title": "Observation",
  "description": "What the shell observed of the store this round (Seen), or null (Unseen). All or nothing: when any call the observation takes failed, it is null, never a partial answer."
}
