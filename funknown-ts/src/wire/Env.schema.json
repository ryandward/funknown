{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "now": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxAttempts": {
      "type": "number",
      "enum": [
        1,
        2,
        3,
        4,
        5
      ]
    },
    "backoff": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3,
      "$comment": "Not expressed here: initialBackoff (item 0) <= maxBackoff (item 1)."
    },
    "writeDeadline": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "now",
    "maxAttempts",
    "backoff",
    "writeDeadline"
  ],
  "additionalProperties": false,
  "title": "Env",
  "description": "now is the shell's clock for this run; maxAttempts, backoff and writeDeadline are deployment config.",
  "$comment": "Not expressed here: now + max(writeDeadline, maxBackoff (backoff item 1)) <= 2^53 - 1."
}
